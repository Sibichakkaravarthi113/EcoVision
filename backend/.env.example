# Comma-separated browser origins allowed by FastAPI.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://eco-vision-wheat.vercel.app

# Optional data.gov.in API access
DATA_GOV_IN_API_KEY=

# Optional database override
# DATABASE_URL=sqlite:///./ecovision.db

# Optional backend-only EcoVision AI provider
# ECOVISION_LLM_URL=
# ECOVISION_LLM_API_KEY=
# ECOVISION_LLM_MODEL=
